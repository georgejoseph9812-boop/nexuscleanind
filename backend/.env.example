# Server Port and Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Production Relational Database (PostgreSQL)
# Supports Supabase direct pooler, Render PostgreSQL, Neon, Railway, or local Docker
# Example local: DATABASE_URL=postgresql://nexus:cleanpassword@localhost:5432/nexus_clean
# Example cloud: DATABASE_URL=postgresql://postgres.yourproject:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Supabase REST Client Configuration (Optional alternative to direct DATABASE_URL)
# When empty, Nexus Clean seamlessly falls back to resilient seed data mode without crashing
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API Key
# (When empty, Nexus Clean returns clearly labeled Prototype Intelligence demo data)
GEMINI_API_KEY=

# JWT Authentication
JWT_SECRET=nexus_clean_hackathon_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d
